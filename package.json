{
  "name": "onmyoji-lineup-atlas",
  "version": "0.7.8",
  "description": "御契 · 阴阳师阵容助手：阵容库管理、游戏原图与御魂全局精算",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "tORHANSxd",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:data": "node tools/build-data.mjs",
    "test": "node --test tests/*.test.cjs",
    "build:login": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-ta-runtime.ps1",
    "pack": "npm run build:login && electron-builder --win --x64 --dir",
    "dist": "npm run build:login && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "io.github.torhansxd.onmyoji-lineup-atlas",
    "productName": "御契",
    "afterPack": "tools/brand-windows.cjs",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/ta-python/**/*",
      "app/**/*",
      "data/images/**/*",
      "data/bundle.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/ta-runtime/atlas-ta-helper",
        "to": "ta-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Yuqi-Setup-${version}-Windows-x64.${ext}",
      "icon": "app/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "御契",
      "uninstallDisplayName": "御契",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "differentialPackage": false
    },
    "publish": null
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "jsqr": "1.4.0"
  }
}
