{
  "name": "onmyoji-lineup-atlas",
  "version": "0.9.5",
  "description": "御契 · 阴阳师阵容助手：阵容库管理、游戏原图与御魂全局精算",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "tORHANSxd",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:data": "node tools/build-data.mjs",
    "test": "node --test tests/*.test.cjs",
    "build:login": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-ta-runtime.ps1",
    "pack": "npm run build:login && electron-builder --win --x64 --dir",
    "dist": "npm run build:login && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "io.github.torhansxd.onmyoji-lineup-atlas",
    "productName": "御契",
    "afterPack": "tools/brand-windows.cjs",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/ta-python/**/*",
      "app/**/*",
      "data/images/**/*",
      "data/bundle.json",
      "data/latest-heroes.json",
      "data/dungeon-catalog/**/*",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "rune-runner",
        "filter": ["verify-rune-runtime.py", "verify-rune-floor.py", "verify-hun13.py", "verify-pve-stage.py", "dojo_area_stage.py", "dojo_guardian_stage.py", "dojo_defense_stage.py", "guild_forest_stage.py", "ten_anniversary_stage.py", "ten_anniversary_boss.py", "ten_anniversary_explore.py", "urdtg_explore.py", "dream_trial_stage.py", "asura_boss_stage.py", "asura_depth_stage.py", "breakthrough_stage.py", "pve_clock.py", "awake_stage.py", "secret_stage.py", "resource_stage.py", "yuling_stage.py", "guild_hunt_stage.py", "guild_retreat_stage.py", "qinfei_boss_stage.py", "guild_crevice_stage.py", "superghost_stage.py", "shanfeng_stage.py", "ji_boss_stage.py", "ji_forest_stage.py", "yanmo_stage.py", "chaji_boss_stage.py", "chaji_map_stage.py", "chaji_side_stage.py", "chaji_story_stage.py", "splyj_tower_stage.py", "splyj_boss_stage.py", "gtw_boss_stage.py", "gtw_hunt_stage.py", "social_play_stage.py", "map_boss_stage.py", "underworld_stage.py", "regional_boss_stage.py", "true_orochi_stage.py", "hunling_stage.py", "qiling_group_stage.py", "shilian_stage.py", "shilian_routes.py", "fengmo_yanwu_stage.py", "fengmo_band_stage.py", "fengmo_band_together.py", "fengmo_dusk_stage.py", "fengmo_songstress_stage.py", "fengmo_mirage_stage.py", "fengmo_catfish_stage.py", "fengmo_skeleton_stage.py", "fengmo_longche_stage.py", "fengmo_spider_stage.py", "fengmo_spider_normal_stage.py", "devil_feast_stage.py", "laolao_fusion_stage.py", "general_soul_stage.py", "tianfa_stage.py", "journey_hard_stage.py", "tuzhizhu_practice.py", "minimum_damage.py", "rune_floor_host.py", "extract-dungeon-catalog.py", "rune_replay.py", "rune_team.py", "rune_random.py"]
      },
      {
        "from": "release/ta-runtime/atlas-ta-helper",
        "to": "ta-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Yuqi-Setup-${version}-Windows-x64.${ext}",
      "icon": "app/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "御契",
      "uninstallDisplayName": "御契",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "differentialPackage": false
    },
    "publish": null
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  }
}
